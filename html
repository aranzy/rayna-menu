<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Rayna Only</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      background: url('background.png') no-repeat center center/cover;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      color: white;
    }

    .container {
      width: 100%;
      max-width: 420px;
      padding: 30px 22px;

      background: rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);

      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 25px;

      text-align: center;

      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

    /* PROFIL */

    .profile {
      margin-bottom: 28px;
    }

    .profile img {
      width: 105px;
      height: 105px;

      border-radius: 50%;
      object-fit: cover;

      border: 3px solid white;

      box-shadow: 0 5px 20px rgba(0,0,0,0.4);

      margin-bottom: 14px;
    }

    .profile h1 {
      font-size: 27px;
      font-weight: bold;
      margin-bottom: 7px;
    }

    .profile p {
      font-size: 14px;
      color: rgba(255,255,255,0.85);
    }

    /* LINK */

    .link-card {
      display: flex;
      align-items: center;

      gap: 14px;

      width: 100%;

      background: rgba(255,255,255,0.13);

      border: 1px solid rgba(255,255,255,0.15);

      padding: 11px;

      margin-bottom: 13px;

      border-radius: 16px;

      text-decoration: none;
      color: white;

      transition: 0.25s ease;
    }

    .link-card:hover {
      transform: scale(1.03);
      background: rgba(255,255,255,0.22);
    }

    .link-card:active {
      transform: scale(0.97);
    }

    .link-card img {
      width: 52px;
      height: 52px;

      object-fit: cover;

      border-radius: 12px;

      background: white;
    }

    .link-text {
      text-align: left;
    }

    .link-text h3 {
      font-size: 16px;
      margin-bottom: 4px;
    }

    .link-text p {
      font-size: 12px;
      color: rgba(255,255,255,0.7);
    }

    /* FOOTER */

    .footer {
      margin-top: 22px;

      font-size: 11px;

      color: rgba(255,255,255,0.55);
    }

  </style>
</head>

